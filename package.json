{
  "name": "dsh-header-masq",
  "version": "0.2.1",
  "description": "DeepSeek Harness 0.2.1-rc.2 plugin that exposes a stable per-session id as x-opencode-session (and other harness headers), including custom pi-ai providers.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "opencode",
    "opencode-go",
    "x-opencode-session",
    "x-deepseek-harness-session-id",
    "session-affinity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deliay/dsh-header-masq.git"
  },
  "homepage": "https://github.com/Deliay/dsh-header-masq#readme",
  "bugs": {
    "url": "https://github.com/Deliay/dsh-header-masq/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "compatibility": {
      "node": ">=20",
      "dsh": ">=0.2.1-rc.2 <0.3.0",
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
